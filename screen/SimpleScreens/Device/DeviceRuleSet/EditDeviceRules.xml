<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tasks" default-menu-index="3">

    <parameter name="deviceId"/>
    <parameter name="deviceRuleSetId" required="true"/>
    <parameter name="selectedDeviceRuleId"/>
    <parameter name="selectedDeviceConfigId"/>

    <transition name="addDeviceRule">
        <service-call name="create#moqui.device.DeviceRule" in-map="[deviceRuleSetId:deviceRuleSetId, deviceId:deviceId,
                ruleTypeEnumId:ruleTypeEnumId, deviceConfigId:deviceConfigId, ruleName:ruleName, description:description,
                priority:priority, fromDate:fromDate, thruDate:thruDate]"/>
        <default-response url="."/>
    </transition>
    <transition name="updateDeviceRule">
        <service-call name="update#moqui.device.DeviceRule" in-map="[deviceRuleId:deviceRuleId, deviceRuleSetId:deviceRuleSetId,
                deviceId:deviceId, ruleTypeEnumId:ruleTypeEnumId, deviceConfigId:deviceConfigId, ruleName:ruleName,
                description:description, priority:priority, fromDate:fromDate, thruDate:thruDate]"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteDeviceRule">
        <service-call name="delete#moqui.device.DeviceRule" in-map="[deviceRuleId:deviceRuleId]"/>
        <default-response url="."/>
    </transition>

    <actions>
        <if condition="deviceId"><entity-find-one entity-name="moqui.device.DeviceDetail" value-field="device"/></if>
        <entity-find-one entity-name="moqui.device.DeviceRuleSet" value-field="deviceRuleSet">
            <field-map field-name="deviceRuleSetId"/>
        </entity-find-one>

        <entity-find entity-name="moqui.device.DeviceRule" list="selectedRuleList">
            <econdition field-name="deviceRuleSetId"/>
            <order-by field-name="priority"/>
            <order-by field-name="fromDate"/>
        </entity-find>
        <set field="selectedDeviceRuleId" from="selectedDeviceRuleId ?: device?.deviceRuleId ?: selectedRuleList?.getAt(0)?.deviceRuleId"/>
        <if condition="selectedDeviceRuleId">
            <entity-find-one entity-name="moqui.device.DeviceRule" value-field="selectedDeviceRule">
                <field-map field-name="deviceRuleId" from="selectedDeviceRuleId"/>
            </entity-find-one>
        </if>
        <set field="selectedDeviceConfigId" from="selectedDeviceConfigId ?: selectedDeviceRule?.deviceConfigId"/>
        <if condition="selectedDeviceConfigId">
            <entity-find-one entity-name="moqui.device.DeviceConfig" value-field="selectedDeviceConfig">
                <field-map field-name="deviceConfigId" from="selectedDeviceConfigId"/>
            </entity-find-one>
        </if>
    </actions>
    <widgets>
        <label text="Tasks for ${deviceRuleSet?.ruleSetName ?: deviceRuleSetId}" type="h4"/>

        <container-dialog id="NewDeviceRule" button-text="New Task">
            <form-single name="NewDeviceRuleForm" transition="addDeviceRule">
                <field name="deviceRuleSetId"><default-field><hidden/></default-field></field>
                <field name="deviceId"><default-field title="Device">
                    <drop-down>
                        <entity-options key="${deviceId}" text="${deviceId}: ${deviceName ?: description ?: ''}">
                            <entity-find entity-name="moqui.device.DeviceDetail">
                                <order-by field-name="deviceName"/>
                                <order-by field-name="deviceId"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="ruleTypeEnumId"><default-field title="Task Type">
                    <widget-template-include location="component://webroot/template/screen/BasicWidgetTemplates.xml#enumDropDown">
                        <set field="enumTypeId" value="DeviceRuleType"/>
                        <set field="allowEmpty" value="true"/>
                    </widget-template-include>
                </default-field></field>
                <field name="deviceConfigId"><default-field title="Device Config">
                    <drop-down>
                        <entity-options key="${deviceConfigId}" text="${deviceConfigId}: ${configName}">
                            <entity-find entity-name="moqui.device.DeviceConfig">
                                <order-by field-name="configName"/>
                                <order-by field-name="deviceConfigId"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="ruleName"><default-field title="Task Name"><text-line size="40"/></default-field></field>
                <field name="description"><default-field title="Description"><text-area rows="4"/></default-field></field>
                <field name="priority"><default-field title="Priority"><text-line size="8" default-value="10"/></default-field></field>
                <field name="fromDate"><default-field title="From Date"><date-time/></default-field></field>
                <field name="thruDate"><default-field title="Thru Date"><date-time/></default-field></field>
                <field name="submit"><default-field><submit text="Add"/></default-field></field>
            </form-single>
        </container-dialog>

        <form-list name="DeviceRuleListForm" list="deviceRuleList" transition="updateDeviceRule" header-dialog="true"
                saved-finds="true" select-columns="true" show-page-size="true"
                show-csv-button="true" show-pdf-button="true" show-all-button="true">
            <entity-find entity-name="moqui.device.DeviceRule" list="deviceRuleList">
                <econdition field-name="deviceRuleSetId"/>
                <date-filter/>
                <search-form-inputs default-order-by="priority,fromDate,deviceRuleId"/>
            </entity-find>

            <field name="deviceRuleSetId"><default-field><hidden/></default-field></field>
            <field name="deviceRuleId">
                <header-field title="Task ID" show-order-by="true"><text-find size="12" default-operator="begins"/></header-field>
                <default-field title="Task ID">
                    <hidden/>
                    <link url="." text="${deviceRuleId}" link-type="anchor">
                        <parameter name="deviceRuleSetId" from="deviceRuleSetId"/>
                        <parameter name="deviceId" from="deviceId" condition="deviceId"/>
                        <parameter name="selectedDeviceRuleId" from="deviceRuleId"/>
                        <parameter name="selectedDeviceConfigId" from="deviceConfigId"/>
                    </link>
                </default-field>
            </field>
            <field name="deviceId">
                <header-field title="Device">
                    <drop-down allow-empty="true">
                        <entity-options key="${deviceId}" text="${deviceId}: ${deviceName ?: description ?: ''}">
                            <entity-find entity-name="moqui.device.DeviceDetail">
                                <order-by field-name="deviceName"/>
                                <order-by field-name="deviceId"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </header-field>
                <default-field title="Device"><display/></default-field>
            </field>
            <field name="ruleTypeEnumId">
                <header-field title="Task Type" show-order-by="true">
                    <widget-template-include location="component://webroot/template/screen/BasicWidgetTemplates.xml#enumDropDown">
                        <set field="enumTypeId" value="DeviceRuleType"/>
                        <set field="allowEmpty" value="true"/>
                        <set field="allowMultiple" value="true"/>
                    </widget-template-include>
                </header-field>
                <default-field title="Task Type"><display-entity entity-name="moqui.basic.Enumeration"/></default-field>
            </field>
            <field name="deviceConfigId">
                <header-field title="Device Config" show-order-by="true">
                    <drop-down allow-empty="true">
                        <entity-options key="${deviceConfigId}" text="${deviceConfigId}: ${configName}">
                            <entity-find entity-name="moqui.device.DeviceConfig">
                                <order-by field-name="configName"/>
                                <order-by field-name="deviceConfigId"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </header-field>
                <default-field title="Device Config">
                    <link url="//${appRoot}/Device/DeviceConfig/EditDeviceConfig" text="${deviceConfigId}" link-type="anchor" condition="deviceConfigId">
                        <parameter name="deviceConfigId" from="deviceConfigId"/>
                    </link>
                    <display text="" condition="!deviceConfigId"/>
                </default-field>
            </field>
            <field name="ruleName">
                <header-field title="Task Name" show-order-by="case-insensitive"><text-find size="24" default-operator="contains"/></header-field>
                <default-field title="Task Name"><display/></default-field>
            </field>
            <field name="description">
                <header-field title="Description"><text-find size="30" default-operator="contains"/></header-field>
                <default-field title="Description"><display/></default-field>
            </field>
            <field name="priority">
                <header-field title="Priority" show-order-by="true"><range-find size="8"/></header-field>
                <default-field title="Priority"><text-line size="8"/></default-field>
            </field>
            <field name="fromDate">
                <header-field title="From Date" show-order-by="true"><date-period allow-empty="true"/></header-field>
                <default-field title="From Date"><display/></default-field>
            </field>
            <field name="thruDate">
                <header-field title="Thru Date" show-order-by="true"><date-period allow-empty="true"/></header-field>
                <default-field title="Thru Date"><display/></default-field>
            </field>
            <field name="submit"><default-field>
                <submit text="Update"/>
                <link url="deleteDeviceRule" text="Delete" confirmation="Delete rule?"/>
            </default-field></field>
        </form-list>

        <section name="SelectedConfigHintSection">
            <condition><expression>selectedDeviceConfigId</expression></condition>
            <widgets>
                <render-mode><text type="html" template="true"><![CDATA[
                    <div class="alert alert-info" role="alert">
                        Selected rule <strong>${selectedDeviceRuleId?html}</strong> uses config
                        <a href="/${appRoot}/Device/DeviceConfig/EditDeviceConfig?deviceConfigId=${selectedDeviceConfigId?url}" class="alert-link">${selectedDeviceConfigId?html}</a>${selectedDeviceConfig?.configName ? ' (' + selectedDeviceConfig.configName + ')' : ''}.
                    </div>
                ]]></text></render-mode>
            </widgets>
        </section>
    </widgets>
</screen>
